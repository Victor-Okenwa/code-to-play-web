{
  "name": "code-to-play-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4555",
    "build": "next build",
    "start": "next start -p 4555",
    "lint": "biome check",
    "format": "biome format --write",
    "preview": "node --require ./scripts/win-symlink.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node --require ./scripts/win-symlink.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "deploy": "node --require ./scripts/win-symlink.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node --require ./scripts/win-symlink.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "upload": "node --require ./scripts/win-symlink.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node --require ./scripts/win-symlink.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@libsql/client": "^0.17.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  },
  "packageManager": "bun@1.3.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
