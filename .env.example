BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4555
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local Next.js only (`bun run dev`). Do not set this in Cloudflare.
DB_FILE_NAME=file:local.db

# Optional. Extra hosts for `next dev` via ngrok/cloudflared (comma-separated).
# Wildcards for *.ngrok-free.app and *.trycloudflare.com are already allowed.
# ALLOWED_DEV_ORIGINS=https://your-name.ngrok-free.app

#  Polar (sandbox first). Product IDs come from the Polar dashboard.
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_WEBHOOK_SECRET=...
POLAR_SERVER=sandbox
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_PER_SPACE=

# Used by Cloudflare cron to refresh Open VSX installs and GitHub changelog.
CRON_SECRET=